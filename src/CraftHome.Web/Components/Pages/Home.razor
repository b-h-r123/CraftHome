@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Owner")]
@rendermode InteractiveServer
@using CraftHome.Web.Services
@inject ConnectionStore Connections
@inject ServerService Servers

<PageTitle>服务器 · CraftHome</PageTitle>
<div class="page-heading"><div><h1>服务器</h1><p>查看运行状态，启动或停止当前服务器。</p></div><a class="btn btn-outline-secondary" href="worlds">地图与存档</a></div>
@if (connection.ApiKey.Length > 0 && connection.InstanceId.Length == 0)
{
    <div class="notice">管理引擎已准备好。<a href="create">打开新手开服向导，创建第一台服务器。</a></div>
}
else
{
@if (connection.DemoMode)
{
    <div class="notice">当前为演示模式。操作只改变演示状态，尚未连接或启动真实 Minecraft。<a href="settings">连接你的服务器</a></div>
}
@if (message is not null)
{
    <div class="notice @(hasError ? "notice-error" : "notice-success")" role="status">@message</div>
}
<section class="server-panel" aria-label="服务器控制">
    <div class="server-heading"><div><h2>@connection.Name</h2><p>@(connection.DemoMode ? "演示实例" : "Minecraft Java 版")</p></div><span class="state @(snapshot?.Status == 3 ? "state-running" : "")">@(snapshot?.StatusText ?? "尚未获取进程状态")</span></div>
    <div class="server-details">
        <div><span>管理节点的游戏查询</span><strong>@GameStatus</strong></div>
        <div><span>进程内存</span><strong>@(snapshot?.MemoryBytes is long bytes ? $"{bytes / 1024 / 1024:N0} MB" : "—")</strong></div>
        <div><span>最近刷新</span><strong>@(lastRefresh?.ToString("HH:mm:ss") ?? "—")</strong></div>
    </div>
    <div class="server-actions">
        <button class="btn btn-primary" disabled="@(!interactive || busy || snapshot?.Status != 0)" @onclick='() => ControlAsync("start")'>启动服务器</button>
        <button class="btn btn-outline-secondary" disabled="@(!interactive || busy || snapshot?.Status != 3)" @onclick='() => Confirm("stop")'>正常停止</button>
        <button class="btn btn-outline-secondary" disabled="@(!interactive || busy || snapshot?.Status != 3)" @onclick='() => Confirm("restart")'>重启</button>
        <button class="btn btn-link" disabled="@(!interactive || busy)" @onclick="RefreshAsync">@(busy ? "正在处理…" : "刷新状态")</button>
    </div>
    @if (pendingAction is not null)
    {
        <div class="confirmation" role="alert">
            <span>@(pendingAction == "stop" ? "停止会断开在线玩家，管理引擎将请求正常保存并退出。" : "重启会短暂断开在线玩家。")</span>
            <button class="btn btn-danger" disabled="@busy" @onclick="ConfirmControlAsync">确认@(pendingAction == "stop" ? "停止" : "重启")</button>
            <button class="btn btn-outline-secondary" disabled="@busy" @onclick="CancelConfirmation">取消</button>
        </div>
    }
    <p class="helper">提交操作后，可刷新查看进程和游戏响应。</p>
</section>
@if (!connection.DemoMode)
{
    <section id="player-connection" class="server-panel join-panel" aria-labelledby="join-heading">
        <div class="panel-heading"><h2 id="join-heading">邀请玩家加入</h2><span class="state">公网连通性待确认</span></div>
        <label for="join-address">Minecraft Java 版连接地址</label>
        <div class="join-address">
            <input id="join-address" class="form-control" readonly value="@connection.Address" />
            <button class="btn btn-outline-secondary" type="button" data-copy-address disabled="@string.IsNullOrWhiteSpace(connection.Address)">复制地址</button>
        </div>
        <div class="helper" role="status"></div>
        @if (string.IsNullOrWhiteSpace(connection.Address) || HasLocalAddress)
        {
            <p class="notice">@(HasLocalAddress ? "当前显示的是本机地址。" : "还没有设置玩家连接地址。") 要邀请外网玩家，请在<a href="settings">连接设置</a>填写游戏服的公网 IP 或域名及端口。</p>
        }
        <p class="helper">把地址发给朋友，让对方从另一网络在游戏的「多人游戏 → 直接连接」里验证。</p>
        <details class="join-help">
            <summary>朋友进不来？逐步检查</summary>
            <ol>
                <li><strong>先看游戏查询。</strong>若服务器停止，先启动；若进程已运行但查询未响应，等待加载后刷新，并查看下方日志。</li>
                <li><strong>核对地址和端口。</strong>朋友应输入上方的游戏地址，使用与服务端相同版本的 Minecraft Java 客户端。</li>
                <li><strong>查询已响应，但外网连接超时或被拒绝。</strong>核对系统防火墙和云安全组是否允许游戏端口的入站 TCP，再从另一网络重试。</li>
                <li><strong>游戏提示白名单或登录。</strong>到<a href="players">玩家管理</a>核对玩家名、准入设置及 AuthMe 状态。</li>
            </ol>
        </details>
    </section>
}
<section class="log-section" aria-label="最近日志">
    <div class="section-heading"><h2>最近日志</h2><span>最多读取最近 16 KB · 手动刷新</span></div>
    <pre class="console" tabindex="0">@(logs.Length == 0 ? "暂无日志。" : logs)</pre>
</section>
<p class="helper"><a href="create">新手开服</a>可以创建独立 Paper 服务器，也可以切换面板管理的实例。</p>
}

@code {
    private ConnectionSettings connection = new();
    private InstanceSnapshot? snapshot;
    private string logs = "";
    private string? message;
    private string? pendingAction;
    private bool hasError;
    private bool busy;
    private bool interactive;
    private DateTimeOffset? lastRefresh;
    private bool HasLocalAddress => Uri.TryCreate("minecraft://" + connection.Address, UriKind.Absolute, out var address) && address.IsLoopback;
    private string GameStatus => connection.DemoMode ? "演示模式" : snapshot switch
    {
        { Status: 0 } => "服务器已停止",
        { Status: 3, GameResponding: true } => "游戏已响应",
        { Status: 2 or 3 } => "等待游戏响应",
        _ => "尚未确认游戏响应"
    };

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { interactive = true; StateHasChanged(); }
    }

    private async Task RefreshAsync()
    {
        busy = true;
        connection = Connections.Read();
        message = null;
        hasError = false;
        try
        {
            if (connection.ApiKey.Length > 0 && connection.InstanceId.Length == 0) { snapshot = null; logs = ""; return; }
            snapshot = await Servers.GetSnapshotAsync();
            logs = await Servers.GetLogsAsync();
            lastRefresh = DateTimeOffset.Now;
        }
        catch (EngineException ex) { snapshot = null; logs = ""; message = ex.Message; hasError = true; }
        finally { busy = false; }
    }

    private void Confirm(string action) => pendingAction = action;
    private void CancelConfirmation() => pendingAction = null;
    private async Task ConfirmControlAsync()
    {
        var action = pendingAction;
        pendingAction = null;
        if (action is not null) await ControlAsync(action);
    }

    private async Task ControlAsync(string action)
    {
        busy = true;
        hasError = false;
        message = null;
        try
        {
            await Servers.ControlAsync(action);
            snapshot = await Servers.GetSnapshotAsync();
            logs = await Servers.GetLogsAsync();
            lastRefresh = DateTimeOffset.Now;
            message = connection.DemoMode ? "演示状态已更新，没有操作真实服务器。" : "请求已提交。请刷新确认服务器最终状态。";
        }
        catch (EngineException ex) { message = ex.Message; hasError = true; }
        finally { busy = false; }
    }
}
